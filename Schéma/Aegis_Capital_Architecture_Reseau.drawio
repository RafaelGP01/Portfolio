<mxfile host="app.diagrams.net" type="device"><diagram id="aegis-net" name="Architecture reseau"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="&lt;b&gt;Aegis Capital — Architecture réseau du système d'information&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1700" height="40" as="geometry" /></mxCell><mxCell id="v2" value="Maquette Cisco Packet Tracer · Projet Management des SI — EFREI · domaine AD &lt;b&gt;aegis-capital.local&lt;/b&gt; · site public &lt;b&gt;aegis-capital.fr&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1700" height="24" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b style='font-size:13px'&gt;Informations générales&lt;/b&gt;&lt;br&gt;• DNS interne, DHCP, NTP : &lt;b&gt;AEGIS-DC01&lt;/b&gt;&lt;br&gt;• Syslog, NetFlow, supervision (SIEM) : &lt;b&gt;AEGIS-SIEM01&lt;/b&gt;&lt;br&gt;• Routage inter-VLAN et filtrage : cœur L3 &lt;b&gt;AEGIS-CORE-SW01&lt;/b&gt;&lt;br&gt;• NAT/PAT et publication Internet : &lt;b&gt;AEGIS-RT01&lt;/b&gt;&lt;br&gt;• Administration : SSH v2 uniquement, depuis le VLAN 10&lt;br&gt;• Dimensionnement : 25 utilisateurs, extensible à 40+ (un /24 par VLAN)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="160" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b style='font-size:13px'&gt;Cible production (hors maquette PT)&lt;/b&gt;&lt;br&gt;• Pare-feu pfSense / OPNsense en bordure (stateful, IDS Suricata)&lt;br&gt;• Serveurs virtualisés sur Proxmox VE, sauvegardés par BKP01&lt;br&gt;• Wi-Fi WPA2/WPA3-Enterprise (802.1X, RADIUS NPS sur DC01)&lt;br&gt;• Copie de sauvegarde externalisée et chiffrée (règle 3-2-1)&lt;br&gt;• Agents Wazuh + GLPI sur tous les serveurs et postes&lt;br&gt;• Accès FAI fibre pro, IP publique fixe" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1820" y="100" width="540" height="160" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;Internet&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;FAI · 203.0.113.1&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="85" width="160" height="95" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;AEGIS-RT01&lt;/b&gt; — Cisco 2911 · routeur de bordure&lt;br&gt;NAT/PAT · ACL_WAN_IN · NetFlow → SIEM01&lt;br&gt;WAN Gi0/0 : 203.0.113.2/30 · LAN Gi0/2 : 10.0.0.2/30&lt;br&gt;&lt;font color='#C62828'&gt;Ouvert depuis Internet : TCP 80, 443 → WEB01 (NAT statique)&lt;/font&gt;&lt;br&gt;&lt;font color='#C62828'&gt;SSH 22 depuis VLAN 10 uniquement&lt;/font&gt;" style="shape=mxgraph.cisco.routers.router;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#FFFFFF;strokeWidth=2;outlineConnect=0;fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1125" y="265" width="70" height="46" as="geometry" /></mxCell><mxCell id="v7" value="" style="shape=mxgraph.cisco.switches.layer_3_switch;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#FFFFFF;strokeWidth=2;outlineConnect=0;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1128" y="420" width="64" height="64" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;AEGIS-CORE-SW01&lt;/b&gt; — Cisco 3650 · cœur L3&lt;br&gt;Routage inter-VLAN (SVI .254) · racine STP (RPVST+)&lt;br&gt;ACL_POSTES_IN (VLAN 30) · ACL_DMZ_IN (VLAN 40)&lt;br&gt;Relais DHCP → DC01 · gestion 172.16.99.254&lt;br&gt;&lt;font color='#C62828'&gt;SSH 22 depuis VLAN 10 uniquement&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1235" y="345" width="420" height="85" as="geometry" /></mxCell><mxCell id="e9" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#C62828;dashed=1;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l10" value="WAN 203.0.113.0/30" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#212121;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="l11" value="Gi0/0" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#212121;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e12" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#EF6C00;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l13" value="Gi0/2" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#212121;" vertex="1" connectable="0" parent="e12"><mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="l14" value="Lien routé 10.0.0.0/30" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroun