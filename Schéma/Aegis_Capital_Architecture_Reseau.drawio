/></mxCell><mxCell id="v26" value="&lt;b style='font-size:11px'&gt;AEGIS-SIEM01&lt;/b&gt;&lt;br&gt;172.16.10.10&lt;br&gt;&lt;i&gt;Wazuh 4 + Zabbix 7&lt;/i&gt;&lt;br&gt;&lt;span style='color:#546E7A'&gt;Ubuntu Server 24.04 LTS&lt;/span&gt;&lt;br&gt;&lt;font color='#C62828'&gt;TCP 443 · 1514 · 1515 · 55000 · 10051&lt;br&gt;UDP 514 (syslog) · 162 · 2055 (NetFlow)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;fontSize=10;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="v16"><mxGeometry x="10.0" y="248" width="160" height="170" as="geometry" /></mxCell><mxCell id="e27" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#F9A825;" edge="1" parent="1" source="v20" target="v25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l28" value="Fa0/1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#212121;" vertex="1" connectable="0" parent="e27"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="v29" value="" style="shape=mxgraph.cisco.servers.fileserver;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#FFFFFF;strokeWidth=2;outlineConnect=0;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="v16"><mxGeometry x="238.5" y="170" width="43" height="62" as="geometry" /></mxCell><mxCell id="v30" value="&lt;b style='font-size:11px'&gt;AEGIS-BKP01&lt;/b&gt;&lt;br&gt;172.16.10.11&lt;br&gt;&lt;i&gt;Proxmox Backup Server&lt;/i&gt;&lt;br&gt;&lt;span style='color:#546E7A'&gt;Debian 12&lt;/span&gt;&lt;br&gt;&lt;font color='#C62828'&gt;TCP 8007 (UI + flux de sauvegarde)&lt;br&gt;SSH 22 (VLAN 10)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;fontSize=10;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="v16"><mxGeometry x="180.0" y="248" width="16